# FastAPI settings
SECRET_KEY=           # Generate: openssl rand -hex 32
FERNET_KEY=           # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCS_ENABLED=true     # Set to false in production

# Database
DATABASE_URL=sqlite:////data/qualys.db   # Path inside container; volume maps /data

# Admin seed (used once on first startup if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=           # Min 12 chars, 2+ numbers, 1+ non-alphanumeric

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
